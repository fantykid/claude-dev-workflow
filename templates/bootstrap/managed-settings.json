{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "Edit(//workspace/repo/**)",
      "Edit(//workspace/bootstrap-manifest.md)",
      "Bash(printenv PROJECT_NAME)",
      "Bash(printenv HOST_PROJECT_DIR)",
      "Bash(date)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf *)",
      "Bash(rm --recursive *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(git *)",
      "Edit(//workspace/scripts/**)",
      "Edit(//workspace/templates/**)",
      "Edit(//workspace/.claude/**)",
      "Read(//workspace/secrets/**)",
      "Read(//workspace/claude-data/**)",
      "Read(//workspace/codex-data/**)",
      "Read(//workspace/.bootstrap-claude/**)",
      "Read(//home/node/.claude/.credentials.json)",
      "Read(//run/secrets/**)",
      "Read(//proc/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "strictPluginOnlyCustomization": true
}
