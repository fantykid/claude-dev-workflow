{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit(//workspace/repo/**)",
      "Edit(//workspace/project-config.json)",
      "Edit(//workspace/bootstrap-manifest.md)",
      "Bash(printenv PROJECT_NAME)",
      "Bash(printenv HOST_PROJECT_DIR)",
      "Bash(date)",
      "Bash(date *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf *)",
      "Bash(rm --recursive *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(git *)",
      "Edit(//workspace/scripts/**)",
      "Edit(//workspace/templates/**)",
      "Edit(//workspace/.claude/**)",
      "Read(//workspace/secrets/**)",
      "Read(//workspace/claude-data/**)",
      "Read(//workspace/codex-data/**)"
    ],
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "strictPluginOnlyCustomization": true
}
